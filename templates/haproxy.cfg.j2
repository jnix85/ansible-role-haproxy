# {{ ansible_managed }}
global
	log /dev/log	local0
	log /dev/log	local1 notice
	chroot /var/lib/haproxy
	stats socket /run/haproxy/admin.sock mode 660 level admin
	stats timeout 30s
	user {{ haproxy_user }}
	group {{ haproxy_group }}
	daemon

	ca-base /etc/ssl/certs
	crt-base /etc/ssl/private

	ssl-default-bind-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384
	ssl-default-bind-ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
	ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets

defaults
	log	global
	mode	{{ haproxy_mode }}
	option	{% if haproxy_mode == 'http' %}httplog{% else %}tcplog{% endif %}

	option	dontlognull
	timeout connect {{ haproxy_timeout_connect }}
	timeout client  {{ haproxy_timeout_client }}
	timeout server  {{ haproxy_timeout_server }}
	timeout tunnel  {{ haproxy_timeout_tunnel }}

{% if haproxy_prometheus_exporter_enabled %}
frontend stats
	bind :{{ haproxy_prometheus_port }}
	mode http
	stats enable
	stats uri {{ haproxy_stats_uri }}
	stats refresh 5s
	http-request use-service prometheus-exporter if { path {{ haproxy_prometheus_metrics_path }} }
{% endif %}

frontend proxmox_in_{{ haproxy_frontend_port }}
	bind :{{ haproxy_frontend_port }} {% if haproxy_mode == 'http' %}ssl crt {{ haproxy_ssl_cert_path }} alpn h2,http/1.1{% endif %}

	mode {{ haproxy_mode }}
{% if haproxy_mode == 'http' %}
	option httplog
	option forwardfor
	http-request set-header X-Forwarded-Proto https if { ssl_fc }
	http-request set-header X-Forwarded-Port %[dst_port]
{% else %}
	option tcplog
{% endif %}
	default_backend {{ haproxy_backend_name }}

frontend proxmox_in_443
	bind :443 {% if haproxy_mode == 'http' %}ssl crt {{ haproxy_ssl_cert_path }} alpn h2,http/1.1{% endif %}

	mode {{ haproxy_mode }}
{% if haproxy_mode == 'http' %}
	option httplog
	option forwardfor
	http-request set-header X-Forwarded-Proto https if { ssl_fc }
	http-request set-header X-Forwarded-Port %[dst_port]
{% else %}
	option tcplog
{% endif %}
	default_backend {{ haproxy_backend_name }}

backend {{ haproxy_backend_name }}
	mode {{ haproxy_mode }}
	balance source
	option tcp-check
{% for server in haproxy_backend_servers %}
	server {{ server.name }} {{ server.ip }}:{{ server.port }} ssl verify none check check-ssl verify none inter 3s fall 3 rise 2
{% endfor %}
